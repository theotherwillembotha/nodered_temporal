{
  "name": "@theotherwillembotha/node-red-temporal",
  "version": "0.4.0",
  "description": "Time value manipulation nodes for Node-RED. Built on @theotherwillembotha/node-red-plugincore.",
  "main": "./build/index.js",
  "exports": "./build/index.js",
  "types": "./build/index.d.ts",
  "author": "Willem Botha (@theotherwillembotha)",
  "license": "ISC",
  "keywords": [
    "node-red",
    "temporal",
    "time",
    "date",
    "duration",
    "timezone"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run clean && tsc && npm run generate-nodes && npm run bundle && npm run copy-files",
    "clean": "rm -rf ./build",
    "generate-nodes": "node build/GenerateNodes.js",
    "bundle": "node esbuild.js",
    "copy-files": "cp -r ./icons ./build/"
  },
  "files": [
    "build/",
    "icons/",
    "documentation/",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theotherwillembotha/nodered_temporal.git"
  },
  "bugs": {
    "url": "https://github.com/theotherwillembotha/nodered_temporal/issues"
  },
  "homepage": "https://github.com/theotherwillembotha/nodered_temporal#readme",
  "engines": {
    "node": ">=18",
    "nodered": ">=4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@formatjs/intl-durationformat": "^0.10.12",
    "@theotherwillembotha/node-red-plugincore": "^0.4.2",
    "temporal-polyfill": "^0.3.2"
  },
  "devDependencies": {
    "@theotherwillembotha/node-red-plugincore": "../nodered_plugincore",
    "@types/node": "^22.15.16",
    "@types/node-red": "~1.3.5",
    "esbuild": "^0.25.0"
  },
  "node-red": {
    "version": ">=4.0.0",
    "nodes": {
      "temporal": "./build/Nodes.js"
    },
    "plugins": {
      "temporal": "./build/Plugins.js"
    }
  }
}
